# Public display flags (safe to commit — these only toggle homepage sections)
NEXT_PUBLIC_SHOW_SKINIFY=true

# GitHub contributions stays off: the GraphQL API 403s without a token, so the
# section only ever renders the third-party ghchart.rshah.org fallback image.
# Turn it on once contributions are fetched server-side with a private token.
NEXT_PUBLIC_SHOW_GITHUB_CONTRIBUTIONS=false
